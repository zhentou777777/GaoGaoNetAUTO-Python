# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ---------------------------------------------------------------- 构建产物
# 二进制不进版本库，改由 GitHub Release 附件分发
build/
dist/
*.spec
release/

# ---------------------------------------------------------------- 本地数据
# 含加密后的 Token / 手机号 / 密码，绝不入库
config.json
config.json.bak
qr_tmp.png
webui.url
config_backup/
logs/

# ---------------------------------------------------------------- 开发调试产物
capture.json
capture.log
apk_js/

# 文档 HTML 是 docs/build_html.py 从 Markdown 生成的副本，不入库；
# 出文档包时由 tools/make_docs_package.py 自动生成。
docs/*.html

# ---------------------------------------------------------------- 敏感文件
# 签名私钥与口令（只发布 .cer 公钥证书）
*.pfx
pfx-password.txt

# ---------------------------------------------------------------- 工作区
.workbuddy/
